# ============================================================
# .env.example - Variables d'environnement pour Moteur de Rapports
# ============================================================

# Base de données PostgreSQL
POSTGRES_DB=moteur_rapports_test
POSTGRES_USER=reportuser
POSTGRES_PASSWORD=change_this_password_in_production
POSTGRES_PORT=5455

# MinIO / S3 Object Storage
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_minio_password_in_production
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_BUCKET=rapports-pdf
S3_REGION=us-east-1

# Sécurité Applicative
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# Moteur de Rendu PDF (Sprint 2 - Gotenberg / Chromium Headless)
GOTENBERG_PORT=3000
GOTENBERG_ENDPOINT=http://localhost:3000
PDF_ENGINE=gotenberg
PDF_TIMEOUT_SECONDS=15

# Backend & Frontend
BACKEND_PORT=8082
FRONTEND_PORT=80

