{
  "version": 2,
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist/report-designer/browser",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://moteur-rapports-production.up.railway.app/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
